# Release-signing credentials. Copy this file to keystore.properties (which is
# gitignored) and fill in real values to produce a signed release build.
#
#   cp keystore.properties.example keystore.properties
#
# When keystore.properties is absent, a requested release build (assembleRelease /
# bundleRelease) FAILS on purpose rather than signing with the non-distributable
# sample debug key. Debug builds are unaffected.

# Path to the release keystore. An absolute path outside the repo is safest so the
# private key never lands in version control; a relative path resolves against the
# app module directory (samples/CameraAccessAndroid/app/).
storeFile=/absolute/path/to/egoflow-release.keystore
storePassword=CHANGE_ME
keyAlias=CHANGE_ME
keyPassword=CHANGE_ME
